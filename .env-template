# --- Global configuration ---
DOMAIN=your-domain.com
CERT_RESOLVER=letsencrypt
ASPNETCORE_ENVIRONMENT=Production
NODE_ENV=production

# Cashly 
CASHLY_POSTGRES_USER=user
CASHLY_POSTGRES_PASSWORD=Your_Password_123
CASHLY_POSTGRES_DB=cashly_prod

# Notes & Notebooks 
COUCHDB_OBSIDIAN_USER=user
COUCHDB_OBSIDIAN_PASSWORD=Your_Password_123

# MR White
MR_WHITE_API_URL=https://your-domain.com/mr-white-api

# Nextcloud
NEXTCLOUD_DOMAIN=your-domain.com
NEXTCLOUD_PROTOCOL=https
NEXTCLOUD_CLI_URL=https://your-domain.com/cloud
NEXTCLOUD_DB_PASSWORD=Your_Password_123

# LAFA Magazzino
LAFA_SUPABASE_URL=https://your-project.supabase.co
LAFA_SUPABASE_ANON_KEY=your-anon-key-here
